# =============================================================================
# Explicitly NOT ignored (override patterns above where needed)
# =============================================================================
# Keep results summaries and tabular outputs in version control
!results/RESULTS.md
!results/*.csv
!results/exp2/RESULTS_exp2.md
!results/exp2/*.csv
!results/exp2/*.json
